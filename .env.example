# LLM 配置
MODEL_ID=openai/kimi-k2.6
API_BASE=https://api.moonshot.cn/v1
API_KEY=your-api-key-here
# QUALITY_JUDGE_MODEL=                 # 质量评估专用模型，留空则复用 MODEL_ID

# Agent 配置
# PROJECT_DIR=./project                # 项目目录（数据、知识、任务）
# SESSIONS_DIR=./sessions              # 会话目录
# SIGNIFICANCE_LEVEL=0.05
# MAX_TOKENS=8000
# TOKEN_THRESHOLD=100000

# 完整请求预算：优先使用已安装模型目录；私有别名/端点差异需明确配置。
# 以下容量数字仅演示配置方法，须替换成实际模型/端点已核实的上限。
# MODEL_CONTEXT_TOKENS=200000
# MODEL_MAX_INPUT_TOKENS=200000
# MODEL_MAX_OUTPUT_TOKENS=16000
# MAX_TOKENS=16000                     # 留空时仍由Provider决定，宿主为已知最大输出预留
PUBLICATION_SOFT_TOKENS=65536            # 软目标可扩展；必答项不据此截断
# MODEL_TOKENIZER=tiktoken:o200k_base   # 明确选择本地缓存编码，或本地tokenizer.json绝对路径
# INPUT_COST_PER_MILLION=              # 当前端点非缓存输入价格，未配置则费用未知
# CACHED_INPUT_COST_PER_MILLION=
# OUTPUT_COST_PER_MILLION=
# COST_CURRENCY=
