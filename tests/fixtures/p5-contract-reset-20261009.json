  "m06_derived_formula": {
    "user_input": "请将 M06-promo.csv 加载为 m06_promo。我要计算账面净收益，文件中的 incremental_revenue 仅作为账面原值，并不证明增量或促销因果。成本口径可能仅扣 coupon_cost，也可能同时扣 coupon_cost 和 channel_cost，请先确认这项实质口径，再计算所选公式。",
    "csv": "order_id,channel,order_amount,incremental_revenue,coupon_cost,channel_cost\r\nP1,all,20,20,3,2\r\nP2,all,25,30,4,3\r\nP3,all,35,25,2,4\r\nP4,all,40,35,5,1\r\n",
    "steps": [
      {
        "tool": "derive_field",
        "arguments": {
          "name": "m06_promo",
          "field_name": "net_book_profit",
          "expression": "incremental_revenue - coupon_cost - channel_cost"
        }
      },
      {
        "tool": "transform_data",
        "arguments": {
          "name": "m06_promo_net_book_profit",
          "operation": "group_aggregate",
          "group_by": [
            "channel"
          ],
          "aggregations": [
            {
              "column": "incremental_revenue",
              "functions": [
                "sum"
              ]
            },
            {
              "column": "coupon_cost",
              "functions": [
                "sum"
              ]
            },
            {
              "column": "channel_cost",
              "functions": [
                "sum"
              ]
            },
            {
              "column": "net_book_profit",
              "functions": [
                "sum",
                "mean",
                "min",
                "max"
              ]
            }
          ],
          "save_as": "m06_promo_net_total"
        }
      }
    ],
    "replay_scope": "original CSV/user/programs; fresh local receipts/confirmation; original paid receipts stay immutable"
  },
